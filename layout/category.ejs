<style>
  @import url('/css/header-card.css');
</style>

<% if (page.category) { %>
  <%# 单个分类页面 %>
  <mdui-card variant="filled" class="header-card">
    <div class="header-title"><%= page.category %></div>
    <div class="header-content">Category</div>
  </mdui-card>

  <mdui-list class="posts-list">
    <% page.posts.forEach(function(post){ %>
      <mdui-list-item href="<%- url_for(post.path) %>">
        <div class="mdui-list-item-content">
          <div class="mdui-list-item-title"><%= post.title %></div>
          <div class="mdui-list-item-text"><%= post.date.format('YYYY-MM-DD') %></div>
        </div>
      </mdui-list-item>
    <% }) %>
  </mdui-list>
<% } else { %>
  <%# 分类主页：列出所有分类 %>
  <mdui-card variant="filled" class="header-card">
    <div class="header-title">Categories</div>
    <div class="header-content">All categories of the blog</div>
  </mdui-card>

  <div class="tags-container">
    <% site.categories.forEach(function(category){ %>
      <mdui-chip rounded href="<%- url_for(category.path) %>">
        <mdui-icon src="/icon/category.svg" slot="icon"></mdui-icon>
        <%= category.name %>
        <span slot="badge"><%= category.posts.length %></span>
      </mdui-chip>
    <% }) %>
  </div>
<% } %>

<script>
  const categories = document.querySelector('.navigation-drawer-list-categories');
  if (categories) categories.active = true;
</script>
