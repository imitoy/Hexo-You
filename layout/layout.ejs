<!DOCTYPE>
<html class="mdui-theme-auto">

<head>
  <title></title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/mdui.css">
  <script src="/js/mdui.global.js"></script>
  <script src="/js/pjax.min.js"></script>
  <script>

// 重新初始化插件：执行 PJAX 后新内容中的所有内联脚本
function reInitializePlugins() {
  const container = document.getElementById('content-container');
  if (!container) return;

  // 1. 执行容器内的所有内联 <script>（排除已有 src 的外部脚本，PJAX 会自动处理）
  const scripts = container.querySelectorAll('script:not([src])');
  scripts.forEach(function(oldScript) {
    const newScript = document.createElement('script');
    newScript.textContent = oldScript.textContent;
    // 复制 data-* 属性
    Array.from(oldScript.attributes).forEach(function(attr) {
      if (attr.name !== 'src') {
        newScript.setAttribute(attr.name, attr.value);
      }
    });
    oldScript.parentNode.replaceChild(newScript, oldScript);
  });

  // 2. 重新执行 code.js 的逻辑：移除代码块行号列
  container.querySelectorAll('.highlight .gutter').forEach(function(el) {
    el.remove();
  });

  // 3. 如果当前是首页，触发瀑布流布局
  if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
    // 双重 requestAnimationFrame 确保在浏览器完成布局后执行
    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        if (typeof layoutWaterfall === 'function') {
          layoutWaterfall();
        }
      });
    });
  }

  // 3. 重新应用导航栏 active 状态
  updateNavigationActive();
}

// 根据当前路径更新导航栏 active 状态
function updateNavigationActive() {
  const path = window.location.pathname;
  const items = document.querySelectorAll('.navigation-drawer-list mdui-list-item');
  items.forEach(function(item) {
    item.active = item.getAttribute('href') === path;
  });
}

// 手动拦截 mdui-chip 和 mdui-list-item 的点击，通过 PJAX 加载
function isMobile() {
  return window.innerWidth <= 900;
}

function attachPjaxToCustomElements(root) {
  root.querySelectorAll('mdui-chip[href], mdui-list-item[href], mdui-card[href]').forEach(function(el) {
    if (el._pjaxAttached) return;
    el._pjaxAttached = true;
    el.addEventListener('click', function(e) {
      var href = el.getAttribute('href');
      if (!href) return;
      if (!href.startsWith('http://') && !href.startsWith('https://') && !href.startsWith('/')) {
        href = '/' + href;
      }
      if (href === '/' && window.location.pathname === '/') return;
      if (href.startsWith('http://') || href.startsWith('https://')) return;
      e.preventDefault();
      e.stopPropagation();
      
      if (window.pjax) {
        window.pjax.loadUrl(href);
      } else {
        window.location.href = href;
      }

      var nav = document.querySelector('.navigation-drawer');
      if (nav && isMobile()) {
        nav.open = false;
      }
    });
  });
}

// ===== 一次性初始化（PJAX 实例、事件监听器等，只执行一次）=====
if (typeof window._pjaxInitialized === 'undefined') {
  window._pjaxInitialized = true;

  window.pjax = new Pjax({
    selectors: [
      "title",
      "#content-container"
    ],
    cacheBust: false,
    debug: false
  });

  // PJAX 完成后重新绑定自定义元素的点击
  var origComplete = window.pjax.afterAllSwitches;
  window.pjax.afterAllSwitches = function() {
    origComplete.call(window.pjax);
    attachPjaxToCustomElements(document);
  };

  // pjax:complete 处理
  document.addEventListener('pjax:complete', function() {
    var container = document.getElementById('content-container');
    reInitializePlugins();
  });

  // 初始绑定自定义元素
  document.addEventListener('DOMContentLoaded', function() {
    attachPjaxToCustomElements(document);
  });
  attachPjaxToCustomElements(document);
}
  </script>

  <%- css('css/root.css') %>
  <%- css('css/content-container.css') %>
  <%- css('css/navigation-drawer.css') %>
</head>

<body>
  <mdui-layout class="root">
    <mdui-top-app-bar class="top-app-bar" scroll-behavior="elevate" scroll-target=".content-container">
      <mdui-button-icon class="navigation-drawer-button" variant="text">
        <mdui-icon src="/icon/menu.svg"></mdui-icon>
      </mdui-button-icon>
      <mdui-top-app-bar-title><%= theme.title %></mdui-top-app-bar-title>
      <div style="flex-grow: 1"></div>
      <mdui-button-icon>
        <mdui-icon src="/icon/search.svg"></mdui-icon>
      </mdui-button-icon>
    </mdui-top-app-bar>

    <mdui-navigation-drawer class="navigation-drawer" close-on-overlay-click open="true">
      <div class="navigation-drawer-container">
      <div class="navigation-drawer-header">
        <mdui-avatar src="<%= theme.avatar %>" class="navigation-drawer-avatar"></mdui-avatar>
        <div class="navigation-drawer-header-title"><%= theme.name %></div>
        <div class="navigation-drawer-header-subtitle"><%= theme.slogan %></div>
      </div>
      <mdui-list class="navigation-drawer-list">
        <mdui-list-item rounded href="/" class="navigation-drawer-list-home">
          Home
          <mdui-icon src="/icon/home.svg" slot="icon"></mdui-icon>
        </mdui-list-item>
        <mdui-list-item rounded href="/posts/" class="navigation-drawer-list-posts">
          Posts
          <mdui-icon src="/icon/article.svg" slot="icon"></mdui-icon>
        </mdui-list-item>
        <!--mdui-list-item rounded href="/categories/">
          Categories
          <mdui-icon src="/icon/category.svg" slot="icon"></mdui-icon>
        </mdui-list-item-->
        <mdui-list-item rounded href="/tags/" class="navigation-drawer-list-tags">
          Tags
          <mdui-icon src="/icon/tag.svg" slot="icon"></mdui-icon>
        </mdui-list-item>
        <mdui-list-item rounded href="/categories/" class="navigation-drawer-list-categories">
          Categories
          <mdui-icon src="/icon/category.svg" slot="icon"></mdui-icon>
        </mdui-list-item>
        <mdui-list-item rounded href="/about/" class="navigation-drawer-list-about">
          About
          <mdui-icon src="/icon/person.svg" slot="icon"></mdui-icon>
        </mdui-list-item>
        <mdui-list-item rounded href="/archives/" class="navigation-drawer-list-archives">
          Archives
          <mdui-icon src="/icon/archive.svg" slot="icon"></mdui-icon>
        </mdui-list-item>
      </mdui-list>
      </div>
    </mdui-navigation-drawer>

    <mdui-layout-main class="layout-main">
      <div class="content-container" id="content-container">
        <%- body %>
      </div>
    </mdui-layout-main>
  </mdui-layout>
  <script src="/js/navigation-drawer.js"></script>
  <script type="module" src="/js/color.js"></script>
</body>

</html>
